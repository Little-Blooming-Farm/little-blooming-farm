# ---------------------------------------------------------------------------
# The Little Blooming Farm — client environment
# Copy to `client/.env`. Anything prefixed VITE_ is embedded in the JS bundle
# and is PUBLIC — never put a secret key here.
# ---------------------------------------------------------------------------

# Base URL of the Express API. No trailing slash.
# Local dev can leave this as-is; vite.config.js proxies /api to :4000.
VITE_API_BASE_URL=https://little-blooming-farm.onrender.com

# Shown in the footer / contact prompts.
VITE_CONTACT_EMAIL=stay@thelittlebloomingfarm.com
VITE_WHATSAPP_NUMBER=
