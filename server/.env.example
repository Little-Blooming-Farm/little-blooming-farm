# ---------------------------------------------------------------------------
# The Little Blooming Farm — server environment TEMPLATE
#
# This file is COMMITTED TO GIT. It must only ever contain placeholders.
#
#   cp server/.env.example server/.env     ← put real values in .env, never here
#
# `.env` is gitignored; this file is not. Anything typed below is published the
# moment you push.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Public URL of the React frontend (used for Stripe redirects + email links).
# No trailing slash.
CLIENT_URL=http://localhost:5173

# Comma-separated list of origins allowed to call this API.
# In production set this to your real domain(s) only — never "*".
CORS_ORIGINS=http://localhost:5173

# Public URL this API is reachable at (used to build outbound iCal feed URLs).
SERVER_URL=http://localhost:4000

# Database ------------------------------------------------------------------
# Use a least-privilege user scoped to this database only (readWrite, not admin).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/little_blooming_farm?retryWrites=true&w=majority

# Auth ----------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h
# Cookie domain for the admin session cookie. Leave blank for localhost.
COOKIE_DOMAIN=
# SameSite policy for the admin session cookie: lax | strict | none.
# Keep `lax` when the site and API share a domain (thelittlebloomingfarm.com +
# api.thelittlebloomingfarm.com) — this is the recommended setup.
# Use `none` ONLY if they are on different domains (e.g. a *.vercel.app front
# end calling a *.onrender.com API); otherwise the browser never sends the
# session cookie and admin login fails after appearing to succeed.
COOKIE_SAMESITE=lax

# Stripe --------------------------------------------------------------------
# Test keys during development (sk_test_… / whsec_…), live keys before launch.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_CURRENCY=usd

# Email ---------------------------------------------------------------------
# PREFERRED: Resend over HTTPS. Needs no SMTP ports, which matters because many
# hosts block them — Render's free tier blocks 25, 465 and 587, and port 25 is
# blocked on every Render plan. Set this and the SMTP block below is ignored.
RESEND_API_KEY=re_REPLACE_ME

# ALTERNATIVE: any SMTP provider (Resend, Postmark, SendGrid, Mailgun, Gmail
# app passwords). Only used when RESEND_API_KEY is empty.
# SMTP_SECURE must match the port: true for 465, false for 587.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=REPLACE_ME
MAIL_FROM="The Little Blooming Farm <stay@thelittlebloomingfarm.com>"
# Internal address that receives a copy of every new booking / cancellation.
OWNER_NOTIFICATION_EMAIL=owner@thelittlebloomingfarm.com

# Media uploads (Cloudinary) ------------------------------------------------
# If these are blank in development, uploads fall back to local disk.
# They are REQUIRED in production — the server refuses to boot without them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=little-blooming-farm

# Booking behaviour ---------------------------------------------------------
# How long an unpaid "pending" booking holds its dates before the calendar
# releases them again (minutes). Should exceed your Stripe Checkout timeout.
BOOKING_HOLD_MINUTES=35
# Minimum nights allowed for a direct booking.
MIN_NIGHTS=2
# How far ahead guests may book (days).
MAX_ADVANCE_DAYS=540

# iCal sync -----------------------------------------------------------------
# Cron expression for polling Airbnb/VRBO feeds. Default: every 30 minutes.
# Airbnb offers iCal export only — there is no push/webhook outside their
# partner API — so this interval IS your exposure window for a cross-platform
# double booking. 15 minutes is a reasonable floor; below that Airbnb may
# start refusing the request.
ICAL_SYNC_CRON=*/30 * * * *
ICAL_SYNC_ENABLED=true

# Test-only. Permits http:// and loopback calendar feeds so the suite can serve
# its own fixture. Ignored entirely when NODE_ENV=production.
ICAL_ALLOW_INSECURE_FEEDS=false
